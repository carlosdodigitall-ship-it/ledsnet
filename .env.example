# ==============================================================================
# LEDSNET — VARIÁVEIS DE AMBIENTE DO SERVIDOR
# ==============================================================================
# Nunca coloque segredos em variáveis VITE_* nem no frontend.

# Firebase Admin / Firestore
FIREBASE_PROJECT_ID=""
FIRESTORE_DATABASE_ID="" # vazio usa o databaseId do firebase-applet-config.json
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Google Places (opcional)
GOOGLE_PLACES_API_KEY=""
GEMINI_API_KEY=""

# Scraper separado: gosom/google-maps-scraper hospedado em VPS
SCRAPER_API_URL=""
SCRAPER_API_KEY=""

# Evolution API — envio real somente quando a instância estiver configurada
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""

# Chave legada do backend atual. Não é autenticação de identidade Firebase.
# Defina uma chave aleatória no ambiente até a migração de autenticação.
ACCESS_KEY=""
