# ==============================================================================
# LEDSNET — VARIÁVEIS DE AMBIENTE DO SERVIDOR (Zero-Trust Security)
# ==============================================================================
# Nenhuma chave desta lista deve ser exposta no navegador (frontend).
# O acesso aos dados pelo cliente é mediado exclusivamente pelo backend Node.js.

# 1. Chave Privada do Dono do Sistema (Acesso ao /painel)
# Defina uma chave forte e privada. O painel só libera dados mediante validação dessa chave.
ACCESS_KEY="LEDS-PRO-2026"

# 2. Google Places API (Opcional, com fallback automático para Gemini 3.8 Flash Maps Grounding)
# Chave obtida no Google Cloud Console com as APIs Places API ativadas.
GOOGLE_PLACES_API_KEY=""

# 3. Evolution API (WhatsApp Comercial)
# Endereço e chave da instância de envio de mensagens e recepção de webhooks.
EVOLUTION_API_URL="https://api.evolution.com"
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="ledsnet-prod"

# 4. Google Gemini API (Para Maps Grounding e IA do motor de busca)
# O AI Studio injeta esta chave automaticamente em tempo de execução.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 5. Firebase & Cloud Firestore
# Informações do projeto provisionado para persistência corporativa.
FIREBASE_PROJECT_ID="gen-lang-client-0177432537"
FIRESTORE_DATABASE_ID="ai-studio-ledsnetprospecoe-638feca9-66ca-4ad6-8181-3f9d1f446d0c"
# Conteúdo JSON completo da chave de conta de serviço (service account) para Vercel / Cloud Functions
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Requisitar e-mail estritamente verificado antes de permitir busca na API (opcional: true/false)
REQUIRE_EMAIL_VERIFIED="false"

# 6. URL da Aplicação e Deploy
APP_URL="https://ledsnet.vercel.app"
