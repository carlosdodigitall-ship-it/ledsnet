# Chave da API Gemini: segredo exclusivo do servidor.
GEMINI_API_KEY=""

# Firebase Web App config (valores públicos de configuração; não inclua chaves privadas).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Firebase Admin SDK: segredo SOMENTE no servidor. Configure no ambiente de hospedagem,
# nunca em variáveis com prefixo VITE_ e nunca em arquivos versionados.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# Alternativamente, configure GOOGLE_APPLICATION_CREDENTIALS no ambiente do servidor.
# FIREBASE_PROJECT_ID=""
