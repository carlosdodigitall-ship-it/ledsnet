{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/entrar", "destination": "/app.html" },
    { "source": "/criar-conta", "destination": "/app.html" },
    { "source": "/verificar-email", "destination": "/app.html" },
    { "source": "/recuperar-senha", "destination": "/app.html" },
    { "source": "/configurar-conta", "destination": "/app.html" },
    { "source": "/painel", "destination": "/app.html" },
    { "source": "/painel/(.*)", "destination": "/app.html" },
    { "source": "/termos", "destination": "/app.html" },
    { "source": "/privacidade", "destination": "/app.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/vendas", "destination": "/landing.html" },
    { "source": "/landing", "destination": "/landing.html" }
  ]
}
