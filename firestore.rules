rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExistingDocument() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function ownsNewDocument() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && (!request.resource.data.keys().hasAny(['ownerId']) || request.resource.data.ownerId == uid);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /{collectionName}/{documentId} {
      allow get, list: if collectionName != 'users' && ownsExistingDocument();
      allow create: if collectionName != 'users' && ownsNewDocument();
      allow update: if collectionName != 'users' && ownsExistingDocument() && ownsNewDocument();
      allow delete: if collectionName != 'users' && ownsExistingDocument();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
